#!/usr/bin/env python3
"""Backlog adapter (SPEC decision 4) on the team console's tracker (TC_* job environment, ADR 0006).

The contract is the subcommand set below and its JSON output; a different tracker replaces this file, not the
skills. Output is JSON on stdout; errors go to stderr with a non-zero exit (3: the project is still on GitHub).
When the second write of a two-write command fails (create --kind question, decide --close, move/close --reason),
stdout still carries the result with "partial": {"stored", "failed", "next", "error"}: do not rerun, run `next`.
Every write is the job's: what only the owner decides (approving, leaving `proposed`, editing approved text) is
refused with the item's console page, where the owner does it.

  backlog init                                   check the console has the plugin's labels (it seeds them at the
                                                 cutover; adding one is the owner's): exit 1 naming the missing ones
  backlog list [--status S] [--kind K] [--label L]... [--milestone M|current|none] [--state open|closed|all]
  backlog show N                                 item with body, labels, comments, asks and owner decisions
  backlog create --title T --kind K [--severity SEV] [--label L]... [--milestone M|current]
                 (--body B | --body-file F)
                 always `proposed` (#452: the owner approves in the console); kind question also needs
                 --owner-category money|scope|release|access|legal|design and --ask "what to answer"
                 [--commands approve,reject] [--recommended C] — anything else is the team's call (`backlog decide`)
  backlog ask N --owner-category C --ask "what to answer" [--commands approve,reject] [--recommended C]
                 put a question to the owner on an existing item (replaces its open ask; the console sets owner:*)
  backlog answer N                               retired: the owner answers in the console (prints the item's URL, exit 2)
  backlog reversals [--days 14]  team decisions the owner answered with /reject since they were made
  backlog decide N (--body B | --body-file F) [--close] [--handles-reversal DECISION_ID]
                 record a team decision (a `decision` comment); --close closes a question it answers;
                 refused while the owner's /reject of the last decision is open, unless it names that /reject
                 by its decision_id (from `reversals`)
  backlog move N STATUS [--reason TEXT]          change the status (done closes; approved is the owner's, #452)
  backlog milestone N TITLE|current|none         put the item into a sprint (or remove it)
  backlog close N [--reason TEXT]                close as not planned (rejected, duplicate, obsolete)
  backlog edit N [--title T] [--body-file F]    change title or body (refused once the owner approved the item, #462)
  backlog label N [+L|-L]...                     add/remove flags; +tier:T / +sev:S set those fields, -tier:T clears
  backlog queue N first|up|down                  move the item in its lane (pm; the order `backlog next` dispatches in)
  backlog comment N (--body B | --body-file F)   a `note` on the item
  backlog link-pr N PR                           record the PR on the item (`pr-links`)
  backlog answers N                              the owner's decisions on the item (approve, reject, go, …): rows
                                                 only the owner writes, so "ignored" is always empty
  backlog vanished [--days 30]                   retired no-op (console rows are append-only): {"vanished": []}
  backlog requests [--milestone M|current|none] [--days 30]
                 pending owner requests from the team console ("sprint → next", "queue → up"); one on a closed
                 item is listed under "ignored"
  backlog request-done N --request-id ID --result applied|declined [--text REASON]
                 answer a pending request (pm); declined needs --text
  backlog next [--now ISO]                       what a development run takes now: dispatch list in the console's
                                                 queue order, skipped issues with reasons, missing architect notes
  backlog sprint current|list
  backlog sprint create TITLE DUE_DATE           DUE_DATE = demo day, YYYY-MM-DD; the console numbers the sprint
"""
from __future__ import annotations

import argparse
import json
import os
import shlex
import sys

sys.dont_write_bytecode = True  # the vendored copy lives in the product repo: no __pycache__ there
from datetime import date, datetime, timedelta, timezone

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from typing import Optional  # noqa: E402

from ptlib import brief, console, gh, owner, ownerrequests, picker, project, review  # noqa: E402
from ptlib.console import instant  # noqa: E402
from ptlib.calendar import KYIV, compute, pick_current_sprint  # noqa: E402
from ptlib.labels import LABELS, STATUSES, KINDS, SEVERITIES  # noqa: E402
from ptlib.tiers import ORDER as TIERS  # noqa: E402


def out(data) -> None:
    json.dump(data, sys.stdout, indent=2, ensure_ascii=False)
    sys.stdout.write("\n")


def body_arg(args) -> str:
    if getattr(args, "body_file", None):
        try:
            with open(args.body_file, encoding="utf-8") as f:
                return f.read()
        except OSError as exc:
            sys.exit(f"cannot read --body-file {args.body_file}: {exc.strerror}")
    return args.body or ""


# Reads: the team console's tracker. Its rows are data; each handler prints only fields it checked the type of.

SUMMARY = ("number", "key", "title", "state", "status", "kind", "labels", "milestone", "url", "updated_at")


def summary(issue: dict) -> dict:
    """A console.as_issue dict in the shape the console reads print: slim's, plus the item key."""
    return {k: issue.get(k) for k in SUMMARY}


def sprint_titles(sprints: list) -> dict:
    return {s["number"]: console.sprint_title(s) for s in sprints}


def console_sprint(sprints: list, value: str, today: date) -> dict:
    """The sprint a --milestone names, as a milestone dict: its title, or `current`."""
    milestones = [console.as_milestone(s) for s in sprints]
    if value == "current":
        found = pick_current_sprint(milestones, today)
        if not found:
            sys.exit("no open sprint with a demo day; run `backlog sprint create`")
        return found
    found = next((m for m in milestones if m["title"] == value), None)
    if not found:
        sys.exit(f"sprint not found: {value}")
    return found


def days_ago(days: int) -> datetime:
    return (datetime.now(timezone.utc) - timedelta(days=days)).replace(microsecond=0)


def decision_entry(d: dict) -> dict:
    command = console.text_of(d, "command")
    if not command:
        raise console.ConsoleError("a decision in the answer has no command", type="unexpected-answer")
    return {"command": command, "text": console.text_of(d, "text") or "", "at": console.text_of(d, "decidedAt"),
            "via": console.text_of(d, "via"), "id": d.get("id"), "ask_id": d.get("askId"),
            "reverses_comment_id": d.get("reversesCommentId"), "url": console.text_of(d, "sourceUrl")}


def cmd_init(_args) -> None:
    # The console seeds the plugin's labels at the cutover and only the owner adds labels: this checks, never writes.
    present = {console.text_of(label, "name") for label in console.labels() if isinstance(label, dict)}
    missing = [name for name in LABELS if name not in present]
    out({"created": [], "kept": [name for name in LABELS if name in present], "missing": missing})
    if missing:
        sys.exit(f"the console project lacks {len(missing)} of the plugin's labels: the owner adds them there")


def cmd_list(args) -> None:
    sprints = console.sprints()
    labels = list(args.label or [])
    filters = {"state": args.state, "status": args.status, "kind": args.kind}
    if args.milestone:
        filters["sprint"] = "none" if args.milestone == "none" else \
            console_sprint(sprints, args.milestone, datetime.now(KYIV).date())["number"]
    if labels:
        filters["label"] = labels[0]  # the console takes one label per request; the rest narrow the answer here
    found = console.issues(sprint_titles(sprints), **filters)
    out([summary(i) for i in found if set(labels) <= set(i["labels"])])


def cmd_show(args) -> None:
    number = args.number
    dto = console.get_item(number)
    asks = console.asks(number)
    open_asks = [console.text_of(a, "ask") for a in asks if a.get("state") == "open"]
    data = summary(console.as_issue(dto, sprint_titles(console.sprints()), ask=open_asks[-1] if open_asks else None))
    data["body"] = console.text_of(dto, "body") or ""
    text = console.text_of
    data["comments"] = []
    for c in console.comments(number):
        author = c.get("author") if isinstance(c.get("author"), dict) else {}
        data["comments"].append({"id": c.get("id"), "kind": text(c, "kind"), "author": text(author, "name"),
                                 "author_kind": text(author, "kind"), "at": text(c, "createdAt"),
                                 "body": text(c, "body") or ""})
    data["asks"] = [{"id": a.get("id"), "category": text(a, "category"), "ask": text(a, "ask"),
                     "commands": [x for x in a["commands"] if isinstance(x, str)]
                     if isinstance(a.get("commands"), list) else [],
                     "recommended": text(a, "recommended"), "state": text(a, "state"),
                     "at": text(a, "createdAt")} for a in asks]
    data["decisions"] = [decision_entry(d) for d in console.item_decisions(number)]
    out(data)


def cmd_answers(args) -> None:
    # Decisions are rows only the owner's identity writes: nothing to screen, so nothing is ever ignored, and no
    # agent can write as the owner (same_account is false by construction).
    found = sorted((decision_entry(d) for d in console.item_decisions(args.number)), key=lambda d: d["at"] or "")
    out({"same_account": False, "commands": found, "ignored": [],
         "done": [d for d in found if d["command"] == "done"], "source": "console"})


def redone_after(number: int, at: datetime) -> bool:
    """Whether the team recorded a decision on the item after `at` (an owner /reject is answered by a later one)."""
    return any(c.get("kind") == "decision" and instant(c.get("createdAt")) > at for c in console.comments(number))


def cmd_reversals(args) -> None:
    """Owner rejects of a team decision since --days that no later team decision on the item answered."""
    since = days_ago(args.days)
    newest = {}
    for d in console.decisions(since=console.query_instant(since), command="reject"):
        number = d["item"].get("number") if isinstance(d.get("item"), dict) else None
        if d.get("reversesCommentId") is None or not isinstance(number, int):
            continue
        if number not in newest or instant(d.get("decidedAt")) >= instant(newest[number].get("decidedAt")):
            newest[number] = d
    titles = sprint_titles(console.sprints()) if newest else {}
    found = []
    for number in sorted(newest):
        reject = newest[number]
        if redone_after(number, instant(reject.get("decidedAt"))):
            continue
        issue = summary(console.as_issue(console.get_item(number), titles))
        found.append(dict(issue, reason=console.text_of(reject, "text") or "", at=console.text_of(reject, "decidedAt"),
                          decision_id=reject.get("id"), reverses_comment_id=reject.get("reversesCommentId"),
                          comment_url=console.text_of(reject, "sourceUrl")))
    out(found)


def request_of(row: dict):
    """The request's {kind, target} or {kind, direction} when it is one the plugin knows, else None."""
    request = row.get("request")
    if not isinstance(request, dict):
        return None
    if request.get("kind") == "sprint" and set(request) == {"kind", "target"} \
            and request["target"] in ownerrequests.TARGETS:
        return {"kind": "sprint", "target": request["target"]}
    if request.get("kind") == "priority" and set(request) == {"kind", "direction"} \
            and request["direction"] in ownerrequests.DIRECTIONS:
        return {"kind": "priority", "direction": request["direction"]}
    return None


def cmd_requests(args) -> None:
    """Pending owner requests from the team console (ADR 0005), for the PM at planning time. The console keeps the
    newest per item and only the owner's identity creates them, so there is no provenance to check here."""
    since = days_ago(args.days)
    result = {"requests": [], "handled": [], "ignored": [], "since": since.strftime("%Y-%m-%dT%H:%M:%SZ"),
              "source": "console"}
    pending = [r for r in console.requests("pending") if instant(r.get("requestedAt")) >= since]
    if not pending:
        out(result)
        return
    sprints = console.sprints()
    open_items = {i["number"]: i for i in console.issues(sprint_titles(sprints), state="open")}
    want = None
    if args.milestone and args.milestone != "none":
        want = console_sprint(sprints, args.milestone, datetime.now(KYIV).date())["title"]
    for row in pending:
        item = row.get("item") if isinstance(row.get("item"), dict) else {}
        number = item.get("number")
        about = open_items.get(number)
        if args.milestone and (about or {}).get("milestone") != want:
            continue
        entry = {"issue": number, "key": console.text_of(item, "key"), "title": console.text_of(item, "title"),
                 "milestone": about["milestone"] if about else None, "status": about["status"] if about else None,
                 "request_id": row.get("id"), "at": console.text_of(row, "requestedAt")}
        request = request_of(row)
        reason = "the item is closed" if about is None else "" if request else "not a request the plugin knows"
        if reason:
            result["ignored"].append(dict(entry, reason=reason))
        else:
            result["requests"].append(dict(entry, **request))
    for key in ("requests", "ignored"):
        result[key].sort(key=lambda e: (e["issue"] if isinstance(e["issue"], int) else 0, e["at"] or ""))
    out(result)


def cmd_next(args) -> None:
    now = datetime.fromisoformat(args.now) if args.now else datetime.now(KYIV)
    if now.tzinfo is None:
        now = now.replace(tzinfo=KYIV)
    sprints = console.sprints()
    sprint = pick_current_sprint([console.as_milestone(s) for s in sprints], now.astimezone(KYIV).date())
    demo = date.fromisoformat(sprint["due_on"][:10]) if sprint else None
    ctx = compute(now, sprint["title"] if sprint else None, demo, project.freeze_days()).to_dict()
    # In the console's queue order (each issue carries `queue`): the picker dispatches in it, not by number.
    issues = console.issues(sprint_titles(sprints), state="open")
    agents_dir = os.path.join(os.getcwd(), ".claude", "agents")
    known = ({f[:-3] for f in os.listdir(agents_dir) if f.endswith(".md")} | {"fullstack-dev"}
             if os.path.isdir(agents_dir) else None)
    plan = picker.pick(issues, ctx["sprint"], ctx, known)
    plan["context"] = ctx
    out(plan)


def cmd_sprint(args) -> None:
    sprints = [console.as_milestone(s) for s in console.sprints()]
    if args.action == "current":
        s = pick_current_sprint(sprints, datetime.now(KYIV).date())
        out({"title": s["title"], "number": s["number"], "due": s["due_on"][:10], "url": None} if s else None)
    else:
        out([{"title": s["title"], "number": s["number"], "state": s["state"], "due": (s["due_on"] or "")[:10]}
             for s in sprints])


# Writes: the console judges each one by the job's role and the transition table (team-console auth/policy.ts);
# this side refuses up front what it knows the owner alone does, and turns the console's refusals into the words
# the skills act on. One Idempotency-Key per request (console.request); a two-step command says how far it got.

OWNER_APPROVES = ("approve", "leave-proposed", "not-approved")
NOT_PLANNED = {"state": "closed", "closedReason": "not-planned"}


def approval_hint(number: Optional[int]) -> str:
    url = console.item_url(number) if number else console.project_url()
    return f"the owner approves in the console: {url}" if url else \
        "the owner approves in the console (set TC_CONSOLE_URL for the link)"


def explain(exc: console.ConsoleError, number: Optional[int]) -> Optional[str]:
    """A console refusal a write can meet, as the skills read it; None for anything `console.report` says better."""
    where = f"#{number}: " if number else ""
    url = console.item_url(number) if number else None
    if exc.status == 403 and exc.type == "transition-owner-only":
        if exc.reason == "edit-after-approval":
            return (f"{where}the approved title and body are the owner's to change (edit-after-approval): add a "
                    f"`backlog comment` note, or the owner edits it in the console{f': {url}' if url else ''}")
        if exc.reason in OWNER_APPROVES:
            return f"{where}{approval_hint(number)}"
        return f"{where}only an owner decision makes this change ({exc.reason}): {exc.detail}"
    if exc.status == 403 and exc.type == "transition-role":
        return f"{where}this job's role may not make this change ({exc.reason}): {exc.detail}"
    if exc.status == 404 and exc.type == "item-not-found":
        return f"{where}no such item in the console project"
    if exc.status == 409 and exc.type == "item-closed":
        return f"{where}the item is closed; `backlog move` reopens it first"
    if exc.status == 409 and exc.type == "request-handled":
        return f"{where}the request was already answered (`backlog requests` lists the pending ones)"
    if exc.status == 412:
        return f"{where}the item changed while it was being written: `backlog show {number}` and repeat the change"
    pr_link = console.pr_link_refusal(exc)
    if pr_link:
        return f"{where}{pr_link}"
    if exc.status == 422 and exc.type == "body-secret":
        return (f"{where}the text carries a secret ({exc.kind or 'credential'} in {exc.field or 'the body'}): remove "
                "it — a job's text never stores a credential")
    return None


def fail(exc: console.ConsoleError, number: Optional[int] = None, progress: str = "") -> None:
    """Exit on a console error; `progress` names what an earlier step of the command already wrote."""
    text = explain(exc, number)
    if text is None:
        if progress:
            print(f"console: {progress}", file=sys.stderr)
        sys.exit(console.report(exc))
    print(f"console: {text}" + (f" ({progress})" if progress else ""), file=sys.stderr)
    sys.exit(console.EXIT_ERROR)


def fail_after_first_write(exc: console.ConsoleError, result: dict, stored: str, failed: str, next_step: str) -> None:
    """Exit on a failed second write of a two-write command, saying the first one is stored.

    A rerun would repeat the first write (a second decision comment, say), so stdout still carries the result so
    far with `partial` naming both writes and the one command that finishes the change; stderr says the same.
    """
    out(dict(result, partial={"stored": stored, "failed": failed, "next": next_step,
                              "error": explain(exc, result["number"]) or str(exc)}))
    fail(exc, result["number"], f"the {stored} is stored, the {failed} is not: do not rerun this command; "
                                f"finish with `{next_step}`")


def note_command(number: int, text: str) -> str:
    return f"backlog comment {number} --body {shlex.quote(text)}"


def ask_command(number: int, question: dict) -> str:
    """The full `backlog ask` invocation that finishes a question whose second write failed — the same
    `--owner-category`/`--ask` (and `--commands`/`--recommended` when not the default) the failed `create` used,
    so `partial.next` is runnable as written instead of a template the caller has to fill in (team-console#703)."""
    parts = [f"backlog ask {number}", "--owner-category", question["category"], "--ask",
             shlex.quote(question["text"])]
    if question["commands"] != ["approve", "reject"]:
        parts += ["--commands", ",".join(question["commands"])]
    if question["recommended"]:
        parts += ["--recommended", question["recommended"]]
    return " ".join(parts)


def written(dto: dict, sprints: Optional[list] = None) -> dict:
    """The item a write answered with, in the summary shape; the sprint title is read only when the item has one."""
    if sprints is None and console._is_number(dto.get("sprint")):
        sprints = console.sprints()
    return summary(console.as_issue(dto, sprint_titles(sprints or [])))


def label_fields(names: list) -> tuple:
    """`--label`/`+label` values as the console takes them: (flags, {tier|severity: value}). `tier:*` and `sev:*`
    are fields; `status:*` and `kind:*` are `move`'s and `create --kind`'s."""
    flags, fields = [], {}
    for name in names:
        prefix, _, value = name.partition(":")
        if prefix == "status":
            sys.exit("use `backlog move` to change status")
        if prefix == "kind":
            sys.exit("the kind is not a label: `backlog create --kind` sets it")
        if prefix == "tier":
            if value not in TIERS:
                sys.exit(f"unknown tier {value!r}; one of {TIERS}")
            fields["tier"] = value
        elif prefix == "sev":
            if value not in SEVERITIES:
                sys.exit(f"unknown severity {value!r}; one of {SEVERITIES}")
            fields["severity"] = value
        else:
            flags.append(name)
    return flags, fields


def ask_input(args) -> dict:
    """The ask's body: category, one-line text, the commands that answer it and the recommended one."""
    text = brief.one_line(args.ask or "")
    if not args.owner_category or not text:
        sys.exit("a question to the owner needs --owner-category and --ask; anything the team may decide is "
                 "recorded with `backlog decide`")
    commands = [c for c in (args.commands or "approve,reject").split(",") if c]
    unknown = [c for c in commands if c not in brief.ANSWERABLE]
    if unknown or not commands or len(set(commands)) != len(commands) or len(commands) > 6:
        sys.exit(f"--commands lists 1 to 6 distinct answer commands out of {', '.join(brief.ANSWERABLE)}")
    if args.recommended and args.recommended not in commands:
        sys.exit("--recommended must be one of --commands")
    return {"category": args.owner_category, "text": text, "commands": commands, "recommended": args.recommended or None}


def ask_entry(dto: dict) -> dict:
    text = console.text_of
    return {"id": dto.get("id"), "category": text(dto, "category"), "ask": text(dto, "ask"),
            "commands": [c for c in dto["commands"] if isinstance(c, str)] if isinstance(dto.get("commands"), list)
            else [], "recommended": text(dto, "recommended"), "state": text(dto, "state")}


def cmd_create(args) -> None:
    if args.kind not in KINDS:
        sys.exit(f"unknown kind {args.kind}; one of {KINDS}")
    if args.status != "proposed":  # #452: a job never creates an item past `proposed`
        sys.exit(f"a job creates items as proposed only; {approval_hint(None)}")
    flags, fields = label_fields(args.label or [])
    if args.severity:
        if args.severity not in SEVERITIES:
            sys.exit(f"unknown severity {args.severity}; one of {SEVERITIES}")
        fields["severity"] = args.severity
    question = ask_input(args) if args.kind == "question" else None
    payload = {"title": args.title, "body": body_arg(args), "kind": args.kind, "status": "proposed",
               "labels": flags, **fields}
    sprints = None
    if args.milestone:
        sprints = console.sprints()
        payload["sprint"] = console_sprint(sprints, args.milestone, datetime.now(KYIV).date())["number"]
    dto = console.create_item(payload)
    result = written(dto, sprints)
    if question:
        # The second write of a question; its failure names the full `backlog ask` command that finishes it.
        try:
            result["ask"] = ask_entry(console.ask(result["number"], **question))
        except console.ConsoleError as exc:
            fail_after_first_write(exc, result, f"item {result['key'] or result['number']}", "question",
                                   ask_command(result["number"], question))
    out(result)


def cmd_ask(args) -> None:
    question = ask_input(args)
    dto = console.get_item(args.number)
    flags = dto.get("flags") if isinstance(dto.get("flags"), list) else []
    if "design:awaiting-approval" in flags:
        sys.exit("designs are answered on their item as they are (the console shows approve · reject); not a question")
    asked = console.ask(args.number, **question)
    out({"issue": args.number, "key": console.text_of(dto, "key"), "url": console.item_url(args.number),
         "ask": ask_entry(asked)})


def cmd_answer(args) -> None:
    # Retired (ADR 0006): decisions are rows only the owner's identity writes; the team links the item instead.
    url = console.item_url(args.number)
    out({"issue": args.number, "url": url, "retired": "backlog answer"})
    print(f"backlog answer is retired: the owner answers in the console"
          f"{f': {url}' if url else ' (set TC_CONSOLE_URL for the link)'}", file=sys.stderr)
    sys.exit(2)


def open_reversal(number: int) -> Optional[dict]:
    """The owner's newest /reject of a team decision on the item, unless a later team decision answered it."""
    rejects = [d for d in console.item_decisions(number)
               if d.get("command") == "reject" and isinstance(d.get("reversesCommentId"), int)]
    if not rejects:
        return None
    newest = max(rejects, key=lambda d: instant(d.get("decidedAt")))
    return None if redone_after(number, instant(newest.get("decidedAt"))) else newest


def decision_body(text: str, reversal: Optional[dict]) -> str:
    if not reversal:
        return text
    reason = console.text_of(reversal, "text") or ""
    return f"**Answers the owner's /reject** (decision {reversal.get('id')}){f': {reason}' if reason else ''}\n\n{text}"


def cmd_decide(args) -> None:
    text = body_arg(args).strip()
    if not text:
        sys.exit("a team decision needs its reasoning: --body or --body-file")
    dto = console.get_item(args.number)
    if args.close and console.text_of(dto, "kind") != "question":
        sys.exit("--close is only for questions a decision answers; move other items through their status")
    # A new decision would move the decision date past an open owner /reject and hide it from `reversals`.
    reversal = open_reversal(args.number)
    if reversal and reversal.get("id") != args.handles_reversal:
        sys.exit(f"#{args.number}: the owner reversed the last team decision (/reject "
                 f"{console.text_of(reversal, 'text') or ''}, decision {reversal.get('id')}). Act on it: record "
                 f"the redone decision with --handles-reversal {reversal.get('id')}, or turn it into an owner "
                 "question with `backlog ask`")
    comment = console.comment(args.number, decision_body(text, reversal), kind="decision")
    result = dict(written(dto), decision_id=comment.get("id"),
                  handles_reversal=reversal.get("id") if reversal else None)
    if args.close:
        try:
            result.update(written(console.update_item(args.number, NOT_PLANNED)))
        except console.ConsoleError as exc:
            fail_after_first_write(exc, result, f"decision {comment.get('id')}", "close",
                                   f"backlog close {args.number}")
    out(result)


def cmd_move(args) -> None:
    if args.status not in STATUSES:
        sys.exit(f"unknown status {args.status}; one of {STATUSES}")
    if args.status == "approved":  # #452: approving is the owner's scope decision
        sys.exit(f"#{args.number}: {approval_hint(args.number)}")

    def patch(current: dict) -> dict:
        # `done` closes by itself; any other status on a closed item reopens it (as the GitHub form did).
        reopen = current.get("state") == "closed" and args.status != "done"
        return {"status": args.status, **({"state": "open"} if reopen else {})}

    result = written(console.update_item(args.number, patch))
    if args.reason:
        note = f"**Status → `{args.status}`**: {args.reason}"
        try:
            console.comment(args.number, note)
        except console.ConsoleError as exc:
            fail_after_first_write(exc, result, f"status {args.status}", "reason note", note_command(args.number, note))
    out(result)


def cmd_milestone(args) -> None:
    sprints = console.sprints()
    number = None if args.title == "none" else console_sprint(sprints, args.title, datetime.now(KYIV).date())["number"]
    out(written(console.update_item(args.number, {"sprint": number}), sprints))


def cmd_close(args) -> None:
    result = written(console.update_item(args.number, NOT_PLANNED))
    if args.reason:
        note = f"**Closed as not planned**: {args.reason}"
        try:
            console.comment(args.number, note)
        except console.ConsoleError as exc:
            fail_after_first_write(exc, result, "close", "reason note", note_command(args.number, note))
    out(result)


def cmd_edit(args) -> None:
    patch = {}
    if args.title:
        patch["title"] = args.title
    if args.body_file or args.body:
        patch["body"] = body_arg(args)  # the ask is a row of its own now, nothing in the body to keep
    if not patch:
        sys.exit("nothing to change: --title and/or --body-file")
    # A lost race on a text edit is reported, never merged: the editor re-reads and edits again.
    out(written(console.update_item(args.number, patch, reapply=False)))


def cmd_label(args) -> None:
    for change in args.changes:
        if change[:1] not in "+-" or len(change) < 2:
            sys.exit(f"label changes look like +name or -name, got {change!r}")
    add, add_fields = label_fields([c[1:] for c in args.changes if c[0] == "+"])
    remove, remove_fields = label_fields([c[1:] for c in args.changes if c[0] == "-"])
    patch = {name: None for name in remove_fields}
    patch.update(add_fields)
    if add:
        patch["addLabels"] = add
    if remove:
        patch["removeLabels"] = remove
    out(written(console.update_item(args.number, patch)))


def cmd_queue(args) -> None:
    dto = console.queue_move(args.number, args.move)
    queue = dto.get("queue") if isinstance(dto.get("queue"), dict) else {}
    out(dict(written(dto), move=args.move, position=queue.get("position"), total=queue.get("total")))


def cmd_comment(args) -> None:
    body = body_arg(args)
    if owner.DECISION_MARKER in body:
        sys.exit("team decisions are recorded with `backlog decide`, not as a plain comment")
    if ownerrequests.first_line(body).startswith(ownerrequests.REQUEST_PREFIX):
        sys.exit("owner requests come only from the team console; answer one with `backlog request-done`")
    if not body.strip():
        sys.exit("an empty comment: --body or --body-file")
    c = console.comment(args.number, body)
    out({"issue": args.number, "id": c.get("id"), "kind": console.text_of(c, "kind"),
         "url": console.item_url(args.number)})


def cmd_link_pr(args) -> None:
    # The PR itself is the VCS's (GitHub until Phase 2); the console records the link as a `pr-linked` event.
    try:
        pr = gh.api(f"repos/{gh.repo()}/pulls/{args.pr}")
    except gh.GhError as exc:
        sys.exit(str(exc))
    # Same rule as `pr link-pr --item` (team-console#628): the PR must name the item it is linked to.
    key = review.item_ref(console.text_of(console.get_item(args.number), "key") or "")
    if not key or "-" not in key:
        sys.exit(f"console: item {args.number} has no key")
    refusal = review.naming_refusal(pr, key)
    if refusal:
        sys.exit(refusal)
    link = console.link_pr(args.number, pr["number"], pr["html_url"], pr["head"]["ref"])
    out({"issue": args.number, "pr": pr["number"], "pr_url": pr["html_url"], "head_ref": pr["head"]["ref"],
         "linked_at": console.text_of(link, "linkedAt"), "url": console.item_url(args.number)})


def cmd_vanished(_args) -> None:
    # Retired: console rows are append-only, so a decision the team acted on cannot disappear. Kept one release
    # for the skills that still call it once per run.
    out({"vanished": [], "checked": 0, "error": "", "history": "console"})


def cmd_request_done(args) -> None:
    """Answer a pending owner request as the PM; the console records which job answered from the token."""
    row = next((r for r in console.item_requests(args.number) if r.get("id") == args.request_id), None)
    if row is None:
        sys.exit(f"#{args.number}: request {args.request_id} is not a request on this item; `backlog requests` "
                 "lists the pending ones with their request_id")
    if row.get("handledAt") is not None:
        sys.exit(f"#{args.number}: request {args.request_id} was already answered ({console.text_of(row, 'result')})")
    reason = brief.one_line(args.text or "")
    if args.result == "declined" and not reason:
        sys.exit("a declined request needs the reason (--text): the owner is told why not")
    handled = console.handle_request(args.request_id, args.result, reason)
    out({"issue": args.number, "request_id": args.request_id, "result": console.text_of(handled, "result"),
         "handled_at": console.text_of(handled, "handledAt"), "url": console.item_url(args.number)})


def cmd_sprint_create(args) -> None:
    if not args.title or not args.due:
        sys.exit("usage: backlog sprint create TITLE YYYY-MM-DD")
    due = date.fromisoformat(args.due)
    s = console.as_milestone(console.create_sprint(due.isoformat(), args.title))
    out({"title": s["title"], "number": s["number"], "due": (s["due_on"] or "")[:10], "url": None})


def main() -> None:
    p = argparse.ArgumentParser(prog="backlog", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("init")
    ls = sub.add_parser("list")
    ls.add_argument("--status"); ls.add_argument("--kind"); ls.add_argument("--label", action="append")
    ls.add_argument("--milestone"); ls.add_argument("--state", default="open", choices=["open", "closed", "all"])
    sh = sub.add_parser("show"); sh.add_argument("number", type=int)
    cr = sub.add_parser("create")
    cr.add_argument("--title", required=True); cr.add_argument("--kind", required=True)
    cr.add_argument("--status", default="proposed"); cr.add_argument("--severity")
    cr.add_argument("--label", action="append"); cr.add_argument("--milestone")
    cr.add_argument("--body"); cr.add_argument("--body-file")
    ak = sub.add_parser("ask"); ak.add_argument("number", type=int)
    for parser, required in ((cr, False), (ak, True)):
        parser.add_argument("--owner-category", required=required, choices=sorted(owner.CATEGORIES))
        parser.add_argument("--ask", required=required)
        parser.add_argument("--commands", help="comma-separated answer commands (default approve,reject)")
        parser.add_argument("--recommended", choices=list(brief.ANSWERABLE))
    an2 = sub.add_parser("answer"); an2.add_argument("number", type=int)
    an2.add_argument("--command"); an2.add_argument("--text"); an2.add_argument("--owner-said")
    rv = sub.add_parser("reversals"); rv.add_argument("--days", type=int, default=14)
    de = sub.add_parser("decide"); de.add_argument("number", type=int); de.add_argument("--body"); de.add_argument("--body-file")
    de.add_argument("--close", action="store_true")
    de.add_argument("--handles-reversal", type=int, help="decision_id of the owner's /reject this decision answers")
    mv = sub.add_parser("move"); mv.add_argument("number", type=int); mv.add_argument("status"); mv.add_argument("--reason")
    ms = sub.add_parser("milestone"); ms.add_argument("number", type=int); ms.add_argument("title")
    cl = sub.add_parser("close"); cl.add_argument("number", type=int); cl.add_argument("--reason")
    ed = sub.add_parser("edit"); ed.add_argument("number", type=int); ed.add_argument("--title")
    ed.add_argument("--body"); ed.add_argument("--body-file")
    lb = sub.add_parser("label"); lb.add_argument("number", type=int); lb.add_argument("changes", nargs="+")
    qu = sub.add_parser("queue"); qu.add_argument("number", type=int); qu.add_argument("move", choices=["first", "up", "down"])
    cm = sub.add_parser("comment"); cm.add_argument("number", type=int); cm.add_argument("--body"); cm.add_argument("--body-file")
    lp = sub.add_parser("link-pr"); lp.add_argument("number", type=int); lp.add_argument("pr", type=int)
    an = sub.add_parser("answers"); an.add_argument("number", type=int)
    va = sub.add_parser("vanished"); va.add_argument("--days", type=int, default=30)
    rq = sub.add_parser("requests"); rq.add_argument("--milestone"); rq.add_argument("--days", type=int, default=30)
    rd = sub.add_parser("request-done"); rd.add_argument("number", type=int)
    rd.add_argument("--request-id", type=int, required=True)
    rd.add_argument("--result", required=True, choices=list(ownerrequests.RESULTS)); rd.add_argument("--text")
    nx = sub.add_parser("next"); nx.add_argument("--now")
    sp = sub.add_parser("sprint"); sp.add_argument("action", choices=["current", "list", "create"])
    sp.add_argument("title", nargs="?"); sp.add_argument("due", nargs="?")
    argv = sys.argv[1:]
    # `label N -name` removes a label; without "--" argparse would read "-name" as an unknown option.
    if len(argv) >= 3 and argv[0] == "label" and "--" not in argv:
        argv = argv[:2] + ["--"] + argv[2:]
    args = p.parse_args(argv)

    handlers = {
        "init": cmd_init, "list": cmd_list, "show": cmd_show, "answers": cmd_answers, "reversals": cmd_reversals,
        "requests": cmd_requests, "next": cmd_next, "sprint": cmd_sprint,
        "create": cmd_create, "ask": cmd_ask, "answer": cmd_answer, "decide": cmd_decide, "move": cmd_move,
        "milestone": cmd_milestone, "close": cmd_close, "edit": cmd_edit, "label": cmd_label, "queue": cmd_queue,
        "comment": cmd_comment, "link-pr": cmd_link_pr, "vanished": cmd_vanished, "request-done": cmd_request_done,
    }
    if args.cmd == "sprint" and args.action == "create":
        handlers["sprint"] = cmd_sprint_create
    try:
        handlers[args.cmd](args)
    except console.ConsoleError as exc:
        fail(exc, getattr(args, "number", None))


if __name__ == "__main__":
    main()
