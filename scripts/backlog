#!/usr/bin/env python3
"""Backlog adapter (SPEC decision 4): reads come from the team console's tracker (TC_* job environment, ADR 0006);
the writes still go to GitHub Issues until they move too (team-console #608).

The contract is the subcommand set below and its JSON output; a different tracker replaces this file, not the
skills. Output is JSON on stdout; errors go to stderr with a non-zero exit (3: the project is still on GitHub).

  backlog init                                   check the console has the plugin's labels (it seeds them at the
                                                 cutover; adding one is the owner's): exit 1 naming the missing ones
  backlog list [--status S] [--kind K] [--label L]... [--milestone M|current|none] [--state open|closed|all]
  backlog show N                                 item with body, labels, comments, asks and owner decisions
  backlog create --title T --kind K [--status proposed] [--severity SEV] [--label L]...
                 [--milestone M|current] (--body B | --body-file F)
                 kind question also needs --owner-category money|scope|release|access|legal|design and
                 --ask "what to answer" — anything else is the team's call (`backlog decide`)
  backlog ask N --owner-category C --ask "what to answer"
                 turn an existing issue into a policy-conform owner question (answer line on top, owner:* label)
  backlog answer N --command approve|reject|go|no-go|override|done --owner-said "…" [--text T]
                 the owner's answer given in the team chat (interactive only — scheduled runs never call it);
                 allowed commands depend on the item: questions and designs approve/reject, the demo issue
                 go/no-go/override, action items done. With the team GitHub App it posts with PT_OWNER_TOKEN
                 (the owner's own token; reference/identities.md) and refuses without it
  backlog reversals [--days 14]  team decisions the owner answered with /reject since they were made
  backlog decide N (--body B | --body-file F) [--close] [--handles-reversal COMMENT_ID]
                 record a team decision on the issue (label team-decided); --close closes a question it answers;
                 refused while the owner's /reject of the last decision is open, unless it names that /reject
  backlog move N STATUS [--reason TEXT]          set the single status:* label (done closes the issue)
  backlog milestone N TITLE|current|none         put the issue into a sprint (or remove it)
  backlog close N [--reason TEXT]                close as not planned (rejected, duplicate, obsolete)
  backlog edit N [--title T] [--body-file F]    change an issue's title or body (the answer line of a question is kept)
  backlog label N [+L|-L]...                     add/remove flags
  backlog comment N (--body B | --body-file F)
  backlog link-pr N PR                           record the PR on the issue
  backlog answers N                              the owner's decisions on the item (approve, reject, go, …): rows
                                                 only the owner writes, so "ignored" is always empty
  backlog vanished [--days 30]                   owner commands a run acted on (`runlog finish --acted`) that
                                                 were deleted since — once per run, never acted on again
  backlog requests [--milestone M|current|none] [--days 30]
                 pending owner requests from the team console ("sprint → next", "queue → up"); one on a closed
                 item is listed under "ignored"
  backlog request-done N --comment-id ID --result applied|declined [--text REASON]
                 answer a pending request with the handled marker, as the team (never the owner's token);
                 declined needs --text
  backlog next [--now ISO]                       what a development run takes now: dispatch list in the console's
                                                 queue order, skipped issues with reasons, missing architect notes
  backlog sprint current|list
  backlog sprint create TITLE DUE_DATE           DUE_DATE = demo day, YYYY-MM-DD
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys

sys.dont_write_bytecode = True  # the vendored copy lives in the product repo: no __pycache__ there
from datetime import date, datetime, timedelta, timezone

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ptlib import brief, console, gh, inbox, owner, ownerrequests, picker, project, provenance, runlogissue  # noqa: E402
from ptlib.calendar import KYIV, compute, pick_current_sprint  # noqa: E402
from ptlib.labels import LABELS, STATUSES, KINDS, SEVERITIES  # noqa: E402


def out(data) -> None:
    json.dump(data, sys.stdout, indent=2, ensure_ascii=False)
    sys.stdout.write("\n")


def body_arg(args) -> str:
    if getattr(args, "body_file", None):
        try:
            with open(args.body_file, encoding="utf-8") as f:
                return f.read()
        except OSError as exc:
            sys.exit(f"cannot read --body-file {args.body_file}: {exc.strerror}")
    return args.body or ""


def slim(issue: dict) -> dict:
    labels = [l["name"] for l in issue.get("labels", [])]
    status = next((l[len("status:"):] for l in labels if l.startswith("status:")), None)
    kind = next((l[len("kind:"):] for l in labels if l.startswith("kind:")), None)
    ms = issue.get("milestone") or {}
    return {
        "number": issue["number"],
        "title": issue["title"],
        "state": issue.get("state"),
        "status": status,
        "kind": kind,
        "labels": labels,
        "milestone": ms.get("title"),
        "url": issue.get("html_url"),
        "updated_at": issue.get("updated_at"),
    }


def current_sprint(repo: str):
    milestones = gh.api_list(f"repos/{repo}/milestones?state=open&per_page=100")
    return pick_current_sprint(milestones, datetime.now(KYIV).date())


def resolve_milestone(repo: str, value):
    if not value:
        return None
    if value == "current":
        sprint = current_sprint(repo)
        if not sprint:
            sys.exit("no open sprint milestone with a due date; run `backlog sprint create`")
        return sprint
    for m in gh.api_list(f"repos/{repo}/milestones?state=all&per_page=100"):
        if m["title"] == value:
            return m
    sys.exit(f"milestone not found: {value}")


# Reads: the team console's tracker. Its rows are data; each handler prints only fields it checked the type of.

SUMMARY = ("number", "key", "title", "state", "status", "kind", "labels", "milestone", "url", "updated_at")


def summary(issue: dict) -> dict:
    """A console.as_issue dict in the shape the console reads print: slim's, plus the item key."""
    return {k: issue.get(k) for k in SUMMARY}


def sprint_titles(sprints: list) -> dict:
    return {s["number"]: console.sprint_title(s) for s in sprints}


def console_sprint(sprints: list, value: str, today: date) -> dict:
    """The sprint a --milestone names, as a milestone dict: its title, or `current`."""
    milestones = [console.as_milestone(s) for s in sprints]
    if value == "current":
        found = pick_current_sprint(milestones, today)
        if not found:
            sys.exit("no open sprint with a demo day; run `backlog sprint create`")
        return found
    found = next((m for m in milestones if m["title"] == value), None)
    if not found:
        sys.exit(f"sprint not found: {value}")
    return found


def instant(value) -> datetime:
    """A console timestamp (`2026-11-12T10:00:00.000Z`) as an aware datetime; the epoch when it is not one."""
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except (AttributeError, ValueError):
        return datetime.fromtimestamp(0, timezone.utc)


def days_ago(days: int) -> datetime:
    return (datetime.now(timezone.utc) - timedelta(days=days)).replace(microsecond=0)


def decision_entry(d: dict) -> dict:
    command = console.text_of(d, "command")
    if not command:
        raise console.ConsoleError("a decision in the answer has no command", type="unexpected-answer")
    return {"command": command, "text": console.text_of(d, "text") or "", "at": console.text_of(d, "decidedAt"),
            "via": console.text_of(d, "via"), "id": d.get("id"), "ask_id": d.get("askId"),
            "reverses_comment_id": d.get("reversesCommentId"), "url": console.text_of(d, "sourceUrl")}


def cmd_init(_args) -> None:
    # The console seeds the plugin's labels at the cutover and only the owner adds labels: this checks, never writes.
    present = {console.text_of(label, "name") for label in console.labels() if isinstance(label, dict)}
    missing = [name for name in LABELS if name not in present]
    out({"created": [], "kept": [name for name in LABELS if name in present], "missing": missing})
    if missing:
        sys.exit(f"the console project lacks {len(missing)} of the plugin's labels: the owner adds them there")


def cmd_list(args) -> None:
    sprints = console.sprints()
    labels = list(args.label or [])
    filters = {"state": args.state, "status": args.status, "kind": args.kind}
    if args.milestone:
        filters["sprint"] = "none" if args.milestone == "none" else \
            console_sprint(sprints, args.milestone, datetime.now(KYIV).date())["number"]
    if labels:
        filters["label"] = labels[0]  # the console takes one label per request; the rest narrow the answer here
    found = console.issues(sprint_titles(sprints), **filters)
    out([summary(i) for i in found if set(labels) <= set(i["labels"])])


def cmd_show(args) -> None:
    number = args.number
    dto = console.get_item(number)
    asks = console.asks(number)
    open_asks = [console.text_of(a, "ask") for a in asks if a.get("state") == "open"]
    data = summary(console.as_issue(dto, sprint_titles(console.sprints()), ask=open_asks[-1] if open_asks else None))
    data["body"] = console.text_of(dto, "body") or ""
    text = console.text_of
    data["comments"] = []
    for c in console.comments(number):
        author = c.get("author") if isinstance(c.get("author"), dict) else {}
        data["comments"].append({"id": c.get("id"), "kind": text(c, "kind"), "author": text(author, "name"),
                                 "author_kind": text(author, "kind"), "at": text(c, "createdAt"),
                                 "body": text(c, "body") or ""})
    data["asks"] = [{"id": a.get("id"), "category": text(a, "category"), "ask": text(a, "ask"),
                     "commands": [x for x in a["commands"] if isinstance(x, str)]
                     if isinstance(a.get("commands"), list) else [],
                     "recommended": text(a, "recommended"), "state": text(a, "state"),
                     "at": text(a, "createdAt")} for a in asks]
    data["decisions"] = [decision_entry(d) for d in console.item_decisions(number)]
    out(data)


def cmd_answers(args) -> None:
    # Decisions are rows only the owner's identity writes: nothing to screen, so nothing is ever ignored, and no
    # agent can write as the owner (same_account is false by construction).
    found = sorted((decision_entry(d) for d in console.item_decisions(args.number)), key=lambda d: d["at"] or "")
    out({"same_account": False, "commands": found, "ignored": [],
         "done": [d for d in found if d["command"] == "done"], "source": "console"})


def cmd_reversals(args) -> None:
    """Owner rejects of a team decision since --days that no later team decision on the item answered."""
    since = days_ago(args.days)
    newest = {}
    for d in console.decisions(since=since.strftime("%Y-%m-%dT%H:%M:%SZ"), command="reject"):
        number = d["item"].get("number") if isinstance(d.get("item"), dict) else None
        if d.get("reversesCommentId") is None or not isinstance(number, int):
            continue
        if number not in newest or instant(d.get("decidedAt")) >= instant(newest[number].get("decidedAt")):
            newest[number] = d
    titles = sprint_titles(console.sprints()) if newest else {}
    found = []
    for number in sorted(newest):
        reject = newest[number]
        at = instant(reject.get("decidedAt"))
        if any(c.get("kind") == "decision" and instant(c.get("createdAt")) > at for c in console.comments(number)):
            continue  # the team redid the decision after the reject
        issue = summary(console.as_issue(console.get_item(number), titles))
        found.append(dict(issue, reason=console.text_of(reject, "text") or "", at=console.text_of(reject, "decidedAt"),
                          decision_id=reject.get("id"), reverses_comment_id=reject.get("reversesCommentId"),
                          comment_url=console.text_of(reject, "sourceUrl")))
    out(found)


def request_of(row: dict):
    """The request's {kind, target} or {kind, direction} when it is one the plugin knows, else None."""
    request = row.get("request")
    if not isinstance(request, dict):
        return None
    if request.get("kind") == "sprint" and set(request) == {"kind", "target"} \
            and request["target"] in ownerrequests.TARGETS:
        return {"kind": "sprint", "target": request["target"]}
    if request.get("kind") == "priority" and set(request) == {"kind", "direction"} \
            and request["direction"] in ownerrequests.DIRECTIONS:
        return {"kind": "priority", "direction": request["direction"]}
    return None


def cmd_requests(args) -> None:
    """Pending owner requests from the team console (ADR 0005), for the PM at planning time. The console keeps the
    newest per item and only the owner's identity creates them, so there is no provenance to check here."""
    since = days_ago(args.days)
    result = {"requests": [], "handled": [], "ignored": [], "since": since.strftime("%Y-%m-%dT%H:%M:%SZ"),
              "source": "console"}
    pending = [r for r in console.requests("pending") if instant(r.get("requestedAt")) >= since]
    if not pending:
        out(result)
        return
    sprints = console.sprints()
    open_items = {i["number"]: i for i in console.issues(sprint_titles(sprints), state="open")}
    want = None
    if args.milestone and args.milestone != "none":
        want = console_sprint(sprints, args.milestone, datetime.now(KYIV).date())["title"]
    for row in pending:
        item = row.get("item") if isinstance(row.get("item"), dict) else {}
        number = item.get("number")
        about = open_items.get(number)
        if args.milestone and (about or {}).get("milestone") != want:
            continue
        entry = {"issue": number, "key": console.text_of(item, "key"), "title": console.text_of(item, "title"),
                 "milestone": about["milestone"] if about else None, "status": about["status"] if about else None,
                 "request_id": row.get("id"), "at": console.text_of(row, "requestedAt")}
        request = request_of(row)
        reason = "the item is closed" if about is None else "" if request else "not a request the plugin knows"
        if reason:
            result["ignored"].append(dict(entry, reason=reason))
        else:
            result["requests"].append(dict(entry, **request))
    for key in ("requests", "ignored"):
        result[key].sort(key=lambda e: (e["issue"] if isinstance(e["issue"], int) else 0, e["at"] or ""))
    out(result)


def cmd_next(args) -> None:
    now = datetime.fromisoformat(args.now) if args.now else datetime.now(KYIV)
    if now.tzinfo is None:
        now = now.replace(tzinfo=KYIV)
    sprints = console.sprints()
    sprint = pick_current_sprint([console.as_milestone(s) for s in sprints], now.astimezone(KYIV).date())
    demo = date.fromisoformat(sprint["due_on"][:10]) if sprint else None
    ctx = compute(now, sprint["title"] if sprint else None, demo, project.freeze_days()).to_dict()
    # In the console's queue order (each issue carries `queue`): the picker dispatches in it, not by number.
    issues = console.issues(sprint_titles(sprints), state="open")
    agents_dir = os.path.join(os.getcwd(), ".claude", "agents")
    known = ({f[:-3] for f in os.listdir(agents_dir) if f.endswith(".md")} | {"fullstack-dev"}
             if os.path.isdir(agents_dir) else None)
    plan = picker.pick(issues, ctx["sprint"], ctx, known)
    plan["context"] = ctx
    out(plan)


def cmd_sprint(args) -> None:
    sprints = [console.as_milestone(s) for s in console.sprints()]
    if args.action == "current":
        s = pick_current_sprint(sprints, datetime.now(KYIV).date())
        out({"title": s["title"], "number": s["number"], "due": s["due_on"][:10], "url": None} if s else None)
    else:
        out([{"title": s["title"], "number": s["number"], "state": s["state"], "due": (s["due_on"] or "")[:10]}
             for s in sprints])


# Writes: still GitHub Issues until team-console #608 moves them.

def cmd_create(repo: str, args) -> None:
    if args.kind not in KINDS:
        sys.exit(f"unknown kind {args.kind}; one of {KINDS}")
    if args.status not in STATUSES:
        sys.exit(f"unknown status {args.status}; one of {STATUSES}")
    labels = [f"kind:{args.kind}", f"status:{args.status}"] + list(args.label or [])
    body = body_arg(args)
    if args.kind == "question":
        # The decision policy, enforced: only owner decisions become questions, and each says how to answer.
        try:
            body = owner.question_body(args.ask or "", body, args.owner_category or "", project.owner_language())
        except ValueError as exc:
            sys.exit(str(exc))
        labels.append(f"owner:{args.owner_category}")
    if args.severity:
        if args.severity not in SEVERITIES:
            sys.exit(f"unknown severity {args.severity}; one of {SEVERITIES}")
        labels.append(f"sev:{args.severity}")
    payload = {"title": args.title, "body": body, "labels": labels}
    ms = resolve_milestone(repo, args.milestone)
    if ms:
        payload["milestone"] = ms["number"]
    out(slim(gh.api(f"repos/{repo}/issues", "POST", payload)))


def cmd_ask(repo: str, args) -> None:
    issue = gh.api(f"repos/{repo}/issues/{args.number}")
    body = issue.get("body") or ""
    if owner.ask_of(body):  # replace an existing answer line rather than stacking two
        body = body.split(owner.ASK_MARKER, 1)[-1]
    try:
        body = owner.question_body(args.ask, body, args.owner_category, project.owner_language())
    except ValueError as exc:
        sys.exit(str(exc))
    if any(l["name"] == "design:awaiting-approval" for l in issue["labels"]):
        sys.exit("designs are answered on their issue as they are (the inbox shows /approve · /reject); not a question")
    labels = sorted({l["name"] for l in issue["labels"] if not l["name"].startswith(("owner:", "kind:"))}
                    | {"kind:question", f"owner:{args.owner_category}"})
    out(slim(gh.api(f"repos/{repo}/issues/{args.number}", "PATCH", {"body": body, "labels": labels})))


def cmd_answer(repo: str, args) -> None:
    issue = gh.api(f"repos/{repo}/issues/{args.number}")
    if issue.get("state") != "open":
        sys.exit(f"#{args.number} is closed; nothing is waiting for an answer there")
    labels = [l["name"] for l in issue["labels"]]
    kind = next((l[5:] for l in labels if l.startswith("kind:")), None)
    section = inbox.classify({"labels": labels, "kind": kind})
    try:
        body = brief.answer_comment(args.command, args.text or "", args.owner_said or "", section or "")
    except ValueError as exc:
        sys.exit(f"#{args.number}: {exc}")
    # Commands count only when the owner's login wrote them; in app mode that needs the owner's own token.
    c = gh.api(f"repos/{repo}/issues/{args.number}/comments", "POST", {"body": body}, auth=gh.owner_token(repo))
    out({"issue": args.number, "answer": f"/{args.command}", "url": c["html_url"]})


def cmd_decide(repo: str, args) -> None:
    text = body_arg(args).strip()
    if not text:
        sys.exit("a team decision needs its reasoning: --body or --body-file")
    issue = gh.api(f"repos/{repo}/issues/{args.number}")
    current = {l["name"] for l in issue["labels"]}
    if args.close and "kind:question" not in current:
        sys.exit("--close is only for questions a decision answers; move other issues through their status")
    # A new decision would move the decision date past an open owner /reject and hide it from `reversals`.
    comments = gh.api_list(f"repos/{repo}/issues/{args.number}/comments?per_page=100")
    rejection = owner.reversed_by_owner(comments, gh.owner_login(repo), provenance.fetch(repo, args.number),
                                        gh.team_logins(repo), gh.acts_as_owner(repo))
    if rejection and str(rejection.get("comment_id")) != str(args.handles_reversal or ""):
        sys.exit(f"#{args.number}: the owner reversed the last team decision (/reject {rejection.get('text', '')}, "
                 f"{rejection.get('url')}). Act on it: record the redone decision with "
                 f"--handles-reversal {rejection.get('comment_id')}, or turn it into an owner question with "
                 "`backlog ask`")
    c = gh.api(f"repos/{repo}/issues/{args.number}/comments", "POST",
               {"body": owner.decision_comment(text, str(rejection["comment_id"]) if rejection else None,
                                               rejection.get("url") or "" if rejection else "")})
    # A decided question is no longer the owner's: drop owner:* so it leaves "Questions" and shows as FYI only.
    labels = sorted({l for l in current if not l.startswith("owner:")} | {"team-decided"})
    patch = {"labels": labels}
    if args.close:
        patch.update(state="closed", state_reason="completed")
    out(dict(slim(gh.api(f"repos/{repo}/issues/{args.number}", "PATCH", patch)), decision_url=c["html_url"]))


def cmd_move(repo: str, args) -> None:
    if args.status not in STATUSES:
        sys.exit(f"unknown status {args.status}; one of {STATUSES}")
    issue = gh.api(f"repos/{repo}/issues/{args.number}")
    labels = [l["name"] for l in issue["labels"] if not l["name"].startswith("status:")]
    labels.append(f"status:{args.status}")
    payload = {"labels": labels}
    if args.status == "done":
        payload["state"] = "closed"
        payload["state_reason"] = "completed"
    elif issue["state"] == "closed":
        payload["state"] = "open"
    updated = gh.api(f"repos/{repo}/issues/{args.number}", "PATCH", payload)
    if args.reason:
        gh.api(f"repos/{repo}/issues/{args.number}/comments", "POST",
               {"body": f"**Status → `{args.status}`**: {args.reason}"})
    out(slim(updated))


def cmd_milestone(repo: str, args) -> None:
    number = None if args.title == "none" else resolve_milestone(repo, args.title)["number"]
    out(slim(gh.api(f"repos/{repo}/issues/{args.number}", "PATCH", {"milestone": number})))


def cmd_close(repo: str, args) -> None:
    if args.reason:
        gh.api(f"repos/{repo}/issues/{args.number}/comments", "POST", {"body": f"**Closed as not planned**: {args.reason}"})
    out(slim(gh.api(f"repos/{repo}/issues/{args.number}", "PATCH", {"state": "closed", "state_reason": "not_planned"})))


def cmd_edit(repo: str, args) -> None:
    patch = {}
    if args.title:
        patch["title"] = args.title
    if args.body_file or args.body:
        body = body_arg(args)
        current = gh.api(f"repos/{repo}/issues/{args.number}").get("body") or ""
        ask = owner.ask_of(current)
        if ask and not owner.ask_of(body):  # never lose the owner's answer line on a question
            body = current.split(owner.ASK_MARKER, 1)[0] + owner.ASK_MARKER + "\n\n" + body.strip() + "\n"
        patch["body"] = body
    if not patch:
        sys.exit("nothing to change: --title and/or --body-file")
    out(slim(gh.api(f"repos/{repo}/issues/{args.number}", "PATCH", patch)))


def cmd_label(repo: str, args) -> None:
    for change in args.changes:
        if change[:1] not in "+-" or len(change) < 2:
            sys.exit(f"label changes look like +name or -name, got {change!r}")
        if change[1:].startswith("status:"):
            sys.exit("use `backlog move` to change status")
    issue = gh.api(f"repos/{repo}/issues/{args.number}")
    labels = {l["name"] for l in issue["labels"]}
    for change in args.changes:
        (labels.add if change[0] == "+" else labels.discard)(change[1:])
    out(slim(gh.api(f"repos/{repo}/issues/{args.number}", "PATCH", {"labels": sorted(labels)})))


def cmd_comment(repo: str, args) -> None:
    if owner.DECISION_MARKER in body_arg(args):
        sys.exit("team decisions are recorded with `backlog decide`, not as a plain comment")
    if ownerrequests.first_line(body_arg(args)).startswith(ownerrequests.REQUEST_PREFIX):
        sys.exit("owner requests come only from the team console; answer one with `backlog request-done`")
    c = gh.api(f"repos/{repo}/issues/{args.number}/comments", "POST", {"body": body_arg(args)})
    out({"id": c["id"], "url": c["html_url"]})


def cmd_link_pr(repo: str, args) -> None:
    pr = gh.api(f"repos/{repo}/pulls/{args.pr}")
    c = gh.api(f"repos/{repo}/issues/{args.number}/comments", "POST",
               {"body": f"PR: {pr['html_url']} (`{pr['head']['ref']}` → `{pr['base']['ref']}`)"})
    out({"issue": args.number, "pr": pr["number"], "pr_url": pr["html_url"], "comment": c["html_url"]})


GONE = re.compile(r"→ HTTP (404|410)\b")


def cmd_vanished(repo: str, args) -> None:
    """Owner commands the team acted on (`runlog finish --acted`) that are gone now: deleted after the fact.

    Once per run, not per issue: it reads the whole run log and one comment list per issue it names.
    """
    acted, error, history_mode = runlogissue.acted_on(repo)
    since = (datetime.now(timezone.utc) - timedelta(days=args.days)).strftime("%Y-%m-%dT%H:%M:%SZ")
    recent = [a for a in acted if (a.get("at") or "") >= since]
    vanished = []
    for number in sorted({a["issue"] for a in recent}):
        try:
            present = {str(c.get("id")) for c in gh.api_list(f"repos/{repo}/issues/{number}/comments?per_page=100")}
            gone = ""
        except gh.GhError as exc:
            if not GONE.search(str(exc)):
                raise
            # The issue itself was deleted or transferred: every command the team acted on there is gone with it.
            present, gone = set(), f"issue #{number} is gone"
        vanished += [dict(a, reason=gone) if gone else a
                     for a in recent if a["issue"] == number and str(a["comment_id"]) not in present]
    out({"vanished": vanished, "checked": len(recent), "error": error, "history": history_mode})


def _request_slugs(repo: str) -> list:
    # The trust root comes from the default branch, never the working tree: changing it takes a merged PR.
    try:
        return project.console_app_slugs_on_default_branch(repo)
    except ValueError as exc:
        sys.exit(str(exc))


def _issue_requests(repo: str, number: int, owner_login: str, slugs: list, team: set, acts: bool,
                    since: str = "") -> tuple:
    """(ownerrequests.evaluate of one issue, history mode)."""
    comments = gh.api_list(f"repos/{repo}/issues/{number}/comments?per_page=100")
    history = provenance.fetch(repo, number)
    found = ownerrequests.evaluate(comments, owner_login, history, slugs, team, acts, since)
    return found, provenance.mode(history)


def cmd_request_done(repo: str, args) -> None:
    """Answer a pending owner request with the handled marker, as the team — never with the owner's token."""
    owner_login = gh.owner_login(repo)
    agents = gh.token_login()
    if not agents or agents.lower() == owner_login.lower():
        sys.exit(f"the handled marker is posted only as the team's identity, and the agents here act as "
                 f"{agents or 'an unknown account'}")
    found, _ = _issue_requests(repo, args.number, owner_login, _request_slugs(repo), gh.team_logins(repo),
                               gh.acts_as_owner(repo))
    pending = found["pending"]
    if not pending or pending["comment_id"] != args.comment_id:
        known = next((e["reason"] for e in found["ignored"] if e["comment_id"] == args.comment_id), "")
        done = next((h for h in found["handled"] if h["comment_id"] == args.comment_id), None)
        why = (f"it was already answered ({done['result']}, {done['url']})" if done else
               f"it does not count: {known}" if known else
               f"the pending request is {pending['comment_id']} (the newest replaces older ones)" if pending else
               "there is no pending owner request there")
        sys.exit(f"#{args.number}: comment {args.comment_id} is not a pending owner request; {why}")
    issue = gh.api(f"repos/{repo}/issues/{args.number}")
    if issue.get("state") != "open" or "pull_request" in issue:
        sys.exit(f"#{args.number} is not an open issue")
    try:
        body = ownerrequests.handled_comment(args.comment_id, args.result, args.text or "", pending["url"] or "",
                                             project.owner_language())
    except ValueError as exc:
        sys.exit(str(exc))
    # The agents' own token (the team app's in app mode): an owner token would make the answer look like the owner's.
    c = gh.api(f"repos/{repo}/issues/{args.number}/comments", "POST", {"body": body})
    out({"issue": args.number, "comment_id": args.comment_id, "result": args.result, "url": c["html_url"]})


def cmd_sprint_create(repo: str, args) -> None:
    if not args.title or not args.due:
        sys.exit("usage: backlog sprint create TITLE YYYY-MM-DD")
    due = date.fromisoformat(args.due)
    m = gh.api(f"repos/{repo}/milestones", "POST", {"title": args.title, "due_on": f"{due.isoformat()}T12:00:00Z"})
    out({"title": m["title"], "number": m["number"], "due": m["due_on"][:10], "url": m["html_url"]})


def main() -> None:
    p = argparse.ArgumentParser(prog="backlog", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("init")
    ls = sub.add_parser("list")
    ls.add_argument("--status"); ls.add_argument("--kind"); ls.add_argument("--label", action="append")
    ls.add_argument("--milestone"); ls.add_argument("--state", default="open", choices=["open", "closed", "all"])
    sh = sub.add_parser("show"); sh.add_argument("number", type=int)
    cr = sub.add_parser("create")
    cr.add_argument("--title", required=True); cr.add_argument("--kind", required=True)
    cr.add_argument("--status", default="proposed"); cr.add_argument("--severity")
    cr.add_argument("--label", action="append"); cr.add_argument("--milestone")
    cr.add_argument("--body"); cr.add_argument("--body-file")
    cr.add_argument("--owner-category", choices=sorted(owner.CATEGORIES)); cr.add_argument("--ask")
    an2 = sub.add_parser("answer"); an2.add_argument("number", type=int)
    an2.add_argument("--command", required=True, choices=list(brief.ANSWERABLE)); an2.add_argument("--text")
    an2.add_argument("--owner-said", required=True)
    rv = sub.add_parser("reversals"); rv.add_argument("--days", type=int, default=14)
    ak = sub.add_parser("ask"); ak.add_argument("number", type=int)
    ak.add_argument("--owner-category", required=True, choices=sorted(owner.CATEGORIES)); ak.add_argument("--ask", required=True)
    de = sub.add_parser("decide"); de.add_argument("number", type=int); de.add_argument("--body"); de.add_argument("--body-file")
    de.add_argument("--close", action="store_true")
    de.add_argument("--handles-reversal", help="comment id of the owner's /reject this decision answers")
    mv = sub.add_parser("move"); mv.add_argument("number", type=int); mv.add_argument("status"); mv.add_argument("--reason")
    ms = sub.add_parser("milestone"); ms.add_argument("number", type=int); ms.add_argument("title")
    cl = sub.add_parser("close"); cl.add_argument("number", type=int); cl.add_argument("--reason")
    ed = sub.add_parser("edit"); ed.add_argument("number", type=int); ed.add_argument("--title")
    ed.add_argument("--body"); ed.add_argument("--body-file")
    lb = sub.add_parser("label"); lb.add_argument("number", type=int); lb.add_argument("changes", nargs="+")
    cm = sub.add_parser("comment"); cm.add_argument("number", type=int); cm.add_argument("--body"); cm.add_argument("--body-file")
    lp = sub.add_parser("link-pr"); lp.add_argument("number", type=int); lp.add_argument("pr", type=int)
    an = sub.add_parser("answers"); an.add_argument("number", type=int)
    va = sub.add_parser("vanished"); va.add_argument("--days", type=int, default=30)
    rq = sub.add_parser("requests"); rq.add_argument("--milestone"); rq.add_argument("--days", type=int, default=30)
    rd = sub.add_parser("request-done"); rd.add_argument("number", type=int)
    rd.add_argument("--comment-id", type=int, required=True)
    rd.add_argument("--result", required=True, choices=list(ownerrequests.RESULTS)); rd.add_argument("--text")
    nx = sub.add_parser("next"); nx.add_argument("--now")
    sp = sub.add_parser("sprint"); sp.add_argument("action", choices=["current", "list", "create"])
    sp.add_argument("title", nargs="?"); sp.add_argument("due", nargs="?")
    argv = sys.argv[1:]
    # `label N -name` removes a label; without "--" argparse would read "-name" as an unknown option.
    if len(argv) >= 3 and argv[0] == "label" and "--" not in argv:
        argv = argv[:2] + ["--"] + argv[2:]
    args = p.parse_args(argv)

    reads = {"init": cmd_init, "list": cmd_list, "show": cmd_show, "answers": cmd_answers, "reversals": cmd_reversals,
             "requests": cmd_requests, "next": cmd_next, "sprint": cmd_sprint}
    if args.cmd in reads and not (args.cmd == "sprint" and args.action == "create"):
        try:
            reads[args.cmd](args)
        except console.ConsoleError as exc:
            sys.exit(console.report(exc))
        return
    writes = {
        "create": cmd_create, "move": cmd_move, "close": cmd_close, "decide": cmd_decide, "ask": cmd_ask,
        "answer": cmd_answer, "milestone": cmd_milestone, "label": cmd_label, "edit": cmd_edit,
        "comment": cmd_comment, "link-pr": cmd_link_pr, "vanished": cmd_vanished, "sprint": cmd_sprint_create,
        "request-done": cmd_request_done,
    }
    try:
        writes[args.cmd](gh.repo(), args)
    except gh.GhError as exc:
        sys.exit(str(exc))


if __name__ == "__main__":
    main()
