#!/usr/bin/env python3
"""Data for the team chat (skills/team-chat): what changed since the owner was last briefed, and what needs them.

  brief [--since ISO]   JSON summary; --since defaults to the last `brief mark`
  brief mark            record that the owner has just been briefed
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from datetime import datetime, timezone

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ptlib import brief, gh, owner, runstate  # noqa: E402
from ptlib.calendar import KYIV, pick_current_sprint  # noqa: E402

LOG_LABEL = "team:run-log"


def run_log(repo: str):
    found = gh.api_list(f"repos/{repo}/issues?state=all&labels={LOG_LABEL}&per_page=5")
    if not found:
        return None, []
    return found[0], gh.api_list(f"repos/{repo}/issues/{found[0]['number']}/comments?per_page=100")


def slim(i: dict) -> dict:
    labels = [l["name"] for l in i.get("labels", [])]
    return {"number": i["number"], "title": i["title"], "url": i["html_url"], "labels": labels,
            "kind": next((l[5:] for l in labels if l.startswith("kind:")), None), "closed_at": i.get("closed_at"),
            "updated_at": i.get("updated_at"), "ask": owner.ask_of(i.get("body") or "")}


def main() -> None:
    p = argparse.ArgumentParser(prog="brief", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("action", nargs="?", default="show", choices=["show", "mark"])
    p.add_argument("--since")
    args = p.parse_args()
    try:
        repo = gh.repo()
        log, comments = run_log(repo)
        if args.action == "mark":
            if not log:
                sys.exit("no run log yet")
            now = datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
            mine = next((c for c in comments if brief.BRIEFED.search(c.get("body") or "")), None)
            if mine:  # one marker comment, updated in place, instead of one per conversation
                gh.api(f"repos/{repo}/issues/comments/{mine['id']}", "PATCH", {"body": brief.briefed_marker(now)})
            else:
                gh.api(f"repos/{repo}/issues/{log['number']}/comments", "POST", {"body": brief.briefed_marker(now)})
            print(json.dumps({"briefed_at": now}))
            return
        since = args.since or brief.briefed_at(comments)
        since_q = f"&since={since}" if since else ""
        # Changes come from what was touched since the last briefing; what needs the owner from everything open.
        touched = [slim(i) for i in gh.api_list(f"repos/{repo}/issues?state=all&per_page=100{since_q}") if "pull_request" not in i]
        open_issues = [slim(i) for i in gh.api_list(f"repos/{repo}/issues?state=open&per_page=100") if "pull_request" not in i]
        prs = [{"number": x["number"], "title": x["title"], "url": x["html_url"], "merged_at": x.get("merged_at")}
               for x in gh.api_list(f"repos/{repo}/pulls?state=closed&sort=updated&direction=desc&per_page=50")]
        milestones = gh.api_list(f"repos/{repo}/milestones?state=open&per_page=100")
        sprint = pick_current_sprint(milestones, datetime.now(KYIV).date())
        sprint_info = ({"title": sprint["title"], "demo": sprint["due_on"][:10], "open": sprint["open_issues"],
                        "closed": sprint["closed_issues"]} if sprint else None)
        paused = bool(log) and "team:paused" in {l["name"] for l in log.get("labels", [])}
        result = brief.summary(since, [i for i in touched if i["closed_at"]], prs,
                               [i for i in touched if "team-decided" in i["labels"]],
                               runstate.parse_runs(comments), [i for i in open_issues if LOG_LABEL not in i["labels"]
                                                               and "team:inbox" not in i["labels"]],
                               sprint_info, paused)
        print(json.dumps(result, indent=2, ensure_ascii=False))
    except gh.GhError as exc:
        sys.exit(str(exc))


if __name__ == "__main__":
    main()
