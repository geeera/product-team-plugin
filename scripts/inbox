#!/usr/bin/env python3
"""The owner's inbox on the team console (TC_* job environment, ADR 0006): "Needs you" is the console's read model.

  inbox show        print it as the markdown list the owner reads (`GET …/projects/:slug/inbox`)
  inbox update      no-op: the console renders Needs you from its rows (decision 12); kept for the skills' run steps
"""
from __future__ import annotations

import argparse
import json
import os
import sys

sys.dont_write_bytecode = True  # the vendored copy lives in the product repo: no __pycache__ there
from datetime import datetime

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ptlib import console, inbox, project  # noqa: E402
from ptlib.calendar import KYIV  # noqa: E402


def build() -> str:
    groups = inbox.console_groups(console.inbox(), console.item_url)
    updated = datetime.now(KYIV).strftime("%d.%m %H:%M")
    return inbox.render_groups(groups, updated, project.owner_language(), inbox.CONSOLE_ACTIONS)


def main() -> None:
    p = argparse.ArgumentParser(prog="inbox", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("action", choices=["update", "show"])
    args = p.parse_args()
    if args.action == "update":
        print(json.dumps({"updated": False, "reason": "the console renders Needs you from rows"}))
        return
    try:
        sys.stdout.write(build())
    except console.ConsoleError as exc:
        sys.exit(console.report(exc))
    except ValueError as exc:
        sys.exit(f"console: {exc}")


if __name__ == "__main__":
    main()
