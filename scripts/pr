#!/usr/bin/env python3
"""Pull requests over the GitHub REST API (no `gh` CLI needed; cloud sessions may not have it).

  pr create --base B --head H --title T (--body B | --body-file F)
  pr view N            state, branches, mergeable, merge state, head sha
  pr checks N          CI of the head commit: {"state": "pass"|"fail"|"pending", "failing": [...], ...}
  pr diff N            the unified diff (for review)
  pr review N --commit SHA (--body B | --body-file F)
                       a review comment bound to the commit that was reviewed (take SHA from `pr view` before
                       reviewing). First line exactly `QA|REVIEW|SECURITY: APPROVED` or `…: CHANGES REQUESTED`
  pr reviews N         review bodies, oldest first
  pr update-branch N   merge the base into the PR branch on GitHub (no force-push); fails on conflicts
  pr files N           changed paths
  pr security-check N  does this PR need a security review? reasons from the paths and the linked issue's labels
  pr gate N            CI plus the independent verdicts it needs: QA, REVIEW, and SECURITY when security-check says so;
                       each must be APPROVED on the current head commit
  pr merge N --method squash|merge [--delete-branch] [--ci-only]
                       refuses unless the gate passes. `squash` for feature/fix/hotfix PRs, `merge` for the
                       stage cut, releases and back-merges (long-lived branches must keep shared history).
                       `--ci-only` skips the verdicts and is only for those branch operations and the
                       `chore/product-team-*` self-update PR
  pr list [--base B] [--state open|closed|all]

Output is JSON (the diff is plain text).
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from urllib.parse import quote

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import re  # noqa: E402

import subprocess  # noqa: E402
import tempfile  # noqa: E402
from pathlib import Path  # noqa: E402

from ptlib import checks, gh, project, review, vendoring  # noqa: E402


def out(data) -> None:
    json.dump(data, sys.stdout, indent=2, ensure_ascii=False)
    sys.stdout.write("\n")


def body_arg(args) -> str:
    if getattr(args, "body_file", None):
        with open(args.body_file, encoding="utf-8") as f:
            return f.read()
    if args.body is None:
        sys.exit("--body or --body-file is required")
    return args.body


def view(repo: str, n: int) -> dict:
    pr = gh.api(f"repos/{repo}/pulls/{n}")
    return {
        "number": pr["number"], "title": pr["title"], "url": pr["html_url"], "state": pr["state"],
        "merged": pr.get("merged", False), "draft": pr.get("draft", False),
        "base": pr["base"]["ref"], "head": pr["head"]["ref"], "head_sha": pr["head"]["sha"],
        # GitHub computes mergeability lazily: null means "ask again in a moment".
        "mergeable": pr.get("mergeable"), "merge_state": pr.get("mergeable_state"),
    }


LONG_LIVED = {"dev", "stage", "main", "master"}


def branch_deletion_blocker(repo: str, number: int, info: dict) -> str:
    """Only short-lived branches of this repository are deleted after a merge."""
    pr = gh.api(f"repos/{repo}/pulls/{number}")
    head_repo = ((pr.get("head") or {}).get("repo") or {}).get("full_name")
    if head_repo != repo:
        return f"the head branch lives in {head_repo or 'a deleted fork'}"
    if info["head"] in LONG_LIVED or info["head"] == info["base"]:
        return f"{info['head']} is a long-lived branch"
    return ""


def ci(repo: str, sha: str) -> dict:
    runs = gh.api_list(f"repos/{repo}/commits/{sha}/check-runs?per_page=100")
    statuses = gh.api_list(f"repos/{repo}/commits/{sha}/statuses?per_page=100")
    suites = gh.api_list(f"repos/{repo}/commits/{sha}/check-suites?per_page=100")
    return checks.summarise(runs, statuses, suites)


def changed_files(repo: str, n: int) -> list:
    """Paths touched, including the old path of a renamed file (moving code out of auth/ is still auth work)."""
    paths = []
    for f in gh.api_list(f"repos/{repo}/pulls/{n}/files?per_page=100"):
        paths.append(f["filename"])
        if f.get("previous_filename"):
            paths.append(f["previous_filename"])
    return paths


def linked_issue_labels(repo: str, n: int) -> list:
    pr = gh.api(f"repos/{repo}/pulls/{n}")
    body = pr.get("body") or ""
    labels = [l["name"] for l in pr.get("labels", [])]
    for number in re.findall(r"(?i)\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?|refs?)\s*:?\s+#(\d+)", body):
        labels += [l["name"] for l in gh.api(f"repos/{repo}/issues/{number}").get("labels", [])]
    return labels


def security_check(repo: str, n: int) -> list:
    return review.security_reasons(changed_files(repo, n), linked_issue_labels(repo, n))


def gate(repo: str, n: int) -> dict:
    info = view(repo, n)
    reasons = security_check(repo, n)
    reviews = gh.api_list(f"repos/{repo}/pulls/{n}/reviews?per_page=100")
    try:
        logins = project.reviewer_logins()
    except ValueError as exc:
        return {"passed": False, "missing": [str(exc)], "required": [], "verdicts": {}, "ci": {}, "security_reasons": []}
    result = review.gate(reviews, info["head_sha"], bool(reasons), logins)
    result["ci"] = ci(repo, info["head_sha"])
    result["security_reasons"] = reasons[:10]
    if not logins:
        result["warning"] = ("same-account mode: any agent can post a verdict; set team.reviewer_logins to a "
                             "separate reviewing account (owner checklist)")
    if result["ci"]["state"] != "pass":
        result["missing"].insert(0, f"CI: {result['ci']['state']}")
        result["passed"] = False
    return result


def git(*args: str, cwd: str = ".") -> bytes:
    proc = subprocess.run(["git", "-C", cwd, *args], capture_output=True, check=False)
    if proc.returncode != 0:
        raise gh.GhError(f"git {' '.join(args)}: {proc.stderr.decode(errors='replace').strip()[:200]}")
    return proc.stdout


def show_json(rev: str, path: str) -> dict:
    try:
        return json.loads(git("show", f"{rev}:{path}"))
    except (gh.GhError, ValueError):
        return {}


def release_tag_commit(version: str) -> str:
    """The commit the plugin's tag v<version> points at ('' when there is no such tag)."""
    out = git("ls-remote", "--tags", vendoring.PLUGIN_REPO, f"refs/tags/v{version}", f"refs/tags/v{version}^{{}}").decode()
    refs = dict(reversed(line.split("\t")) for line in out.splitlines() if "\t" in line)
    return refs.get(f"refs/tags/v{version}^{{}}") or refs.get(f"refs/tags/v{version}", "")


def verify_self_update(repo: str, n: int, info: dict) -> list:
    """Problems with a self-update PR; [] only when its own changes are exactly a newer tagged plugin release.

    Works on git objects, not API views: the PR head is fetched and must equal the sha that will be merged; the
    changes are the tree diff from the merge base (so symlinks, modes, renames and large PRs are all visible).
    """
    head = info["head_sha"]
    git("fetch", "-q", "origin", f"+refs/pull/{n}/head:refs/pt/pr-{n}", f"+refs/heads/{info['base']}:refs/pt/base-{n}")
    if git("rev-parse", f"refs/pt/pr-{n}").decode().strip() != head:
        return ["the PR moved while it was being verified; try again"]
    base = git("merge-base", f"refs/pt/base-{n}", head).decode().strip()
    entries = vendoring.parse_diff_tree(git("diff-tree", "-r", "--no-renames", "-z", base, head))

    claimed = show_json(head, vendoring.MANIFEST)
    installed = show_json(base, vendoring.MANIFEST)
    commit = claimed.get("commit", "")
    with tempfile.TemporaryDirectory() as tmp:
        try:
            git("init", "-q", cwd=tmp)
            git("fetch", "-q", "--depth", "1", vendoring.PLUGIN_REPO, commit, cwd=tmp)
            git("checkout", "-q", "FETCH_HEAD", cwd=tmp)
        except gh.GhError:
            return [f"cannot fetch plugin commit {commit[:12] or '(none)'}"]
        # The version comes from the release itself, never from the product's manifest.
        version = json.loads((Path(tmp) / ".claude-plugin" / "plugin.json").read_text())["version"]
        if release_tag_commit(version) != commit:
            return [f"plugin commit {commit[:12]} is not the release tag v{version}"]
        if claimed.get("version") != version:
            return [f"manifest says {claimed.get('version')!r}, the release is {version}"]
        try:
            if installed and vendoring.parse_version(version) <= vendoring.parse_version(installed.get("version", "")):
                return [f"{version} is not newer than the installed {installed.get('version')}"]
        except ValueError as exc:
            return [str(exc)]
        pinned = project.plugin_ref()
        if pinned.startswith("v") and pinned != f"v{version}":
            return [f"the product pins {pinned}, this is v{version}"]
        expected = vendoring.render(Path(tmp), version)
        modes = vendoring.modes(Path(tmp))
    expected[vendoring.MANIFEST] = vendoring.manifest_bytes(version, commit, expected)
    return vendoring.verify_tree(entries, expected, modes, set(installed.get("files", {})))


def main() -> None:
    p = argparse.ArgumentParser(prog="pr", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    c = sub.add_parser("create"); c.add_argument("--base", required=True); c.add_argument("--head", required=True)
    c.add_argument("--title", required=True); c.add_argument("--body"); c.add_argument("--body-file")
    for name in ("view", "checks", "diff", "reviews", "update-branch", "files", "security-check", "gate"):
        sub.add_parser(name).add_argument("number", type=int)
    r = sub.add_parser("review"); r.add_argument("number", type=int); r.add_argument("--commit", required=True)
    r.add_argument("--body"); r.add_argument("--body-file")
    m = sub.add_parser("merge"); m.add_argument("number", type=int)
    m.add_argument("--method", required=True, choices=["squash", "merge", "rebase"]); m.add_argument("--delete-branch", action="store_true")
    m.add_argument("--ci-only", action="store_true")
    ls = sub.add_parser("list"); ls.add_argument("--base"); ls.add_argument("--state", default="open", choices=["open", "closed", "all"])
    args = p.parse_args()

    try:
        repo = gh.repo()
        if args.cmd == "create":
            pr = gh.api(f"repos/{repo}/pulls", "POST",
                        {"base": args.base, "head": args.head, "title": args.title, "body": body_arg(args)})
            out({"number": pr["number"], "url": pr["html_url"]})
        elif args.cmd == "view":
            out(view(repo, args.number))
        elif args.cmd == "checks":
            out(ci(repo, view(repo, args.number)["head_sha"]))
        elif args.cmd == "diff":
            sys.stdout.write(gh.raw(f"repos/{repo}/pulls/{args.number}", "application/vnd.github.diff"))
        elif args.cmd == "review":
            # Verdicts go out as the reviewing account when its token is present (see the owner checklist).
            rv = gh.api(f"repos/{repo}/pulls/{args.number}/reviews", "POST",
                        {"event": "COMMENT", "body": body_arg(args), "commit_id": args.commit}, auth=gh.review_token())
            out({"id": rv["id"], "url": rv.get("html_url")})
        elif args.cmd == "reviews":
            out([{"author": (r.get("user") or {}).get("login"), "at": r.get("submitted_at"), "body": r.get("body") or ""}
                 for r in gh.api_list(f"repos/{repo}/pulls/{args.number}/reviews?per_page=100")])
        elif args.cmd == "update-branch":
            head = view(repo, args.number)["head_sha"]
            out(gh.api(f"repos/{repo}/pulls/{args.number}/update-branch", "PUT", {"expected_head_sha": head}))
        elif args.cmd == "files":
            out(changed_files(repo, args.number))
        elif args.cmd == "security-check":
            reasons = security_check(repo, args.number)
            out({"required": bool(reasons), "reasons": reasons})
        elif args.cmd == "gate":
            out(gate(repo, args.number))
        elif args.cmd == "merge":
            info = view(repo, args.number)
            if args.ci_only:
                head_repo = ((gh.api(f"repos/{repo}/pulls/{args.number}").get("head") or {}).get("repo") or {}).get("full_name")
                refusal = review.ci_only_allowed(info["head"], info["base"], changed_files(repo, args.number))
                if not refusal and head_repo != repo:
                    refusal = f"the head branch lives in {head_repo or 'a deleted fork'}"
                if not refusal and info["head"].startswith("chore/product-team-"):
                    problems = verify_self_update(repo, args.number, info)
                    refusal = "; ".join(problems[:5])
                if refusal:
                    sys.exit(f"--ci-only refused: {refusal}")
            if args.ci_only:
                state = ci(repo, info["head_sha"])
                if state["state"] != "pass":
                    sys.exit(f"refusing to merge #{args.number}: CI is {state['state']} {state['failing'] or state['pending']}")
            else:
                result = gate(repo, args.number)
                if not result["passed"]:
                    sys.exit(f"refusing to merge #{args.number}: " + "; ".join(result["missing"]))
            res = gh.api(f"repos/{repo}/pulls/{args.number}/merge", "PUT",
                         {"merge_method": args.method, "sha": info["head_sha"]})
            deleted = False
            if args.delete_branch:
                reason = branch_deletion_blocker(repo, args.number, info)
                if reason:
                    print(f"not deleting the branch: {reason}", file=sys.stderr)
                else:
                    gh.api(f"repos/{repo}/git/refs/heads/{quote(info['head'], safe='/')}", "DELETE")
                    deleted = True
            out({"merged": res.get("merged"), "sha": res.get("sha"), "branch_deleted": deleted})
        else:
            query = f"state={args.state}&per_page=100" + (f"&base={quote(args.base)}" if args.base else "")
            out([{"number": x["number"], "title": x["title"], "base": x["base"]["ref"], "head": x["head"]["ref"],
                  "url": x["html_url"]} for x in gh.api_list(f"repos/{repo}/pulls?{query}")])
    except gh.GhError as exc:
        sys.exit(str(exc))


if __name__ == "__main__":
    main()
