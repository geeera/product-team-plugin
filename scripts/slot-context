#!/usr/bin/env python3
"""Print the current slot context as JSON: Kyiv local time, mode (normal | burn | freeze), cut day, caps.

  slot-context                 reads the current sprint and the team config from the team console (TC_* job
                               environment); `team_config` names the revision it used
  slot-context --offline       calendar only (no sprint, so never freeze), no console call
  slot-context --now ISO       evaluate at a given instant (testing / planning)

With the console, freeze days and caps come from its team config (`…/team-config/resolved`, ADR 0009); a view it
cannot read or check is a refusal (exit 1), never a fallback to project.yml. --offline reads sprint.freeze_days
from .product-team/project.yml as before (caps overrides are applied by the calling skill), but never inside a
console job (TC_API_URL, TC_JOB_TOKEN, TC_PROJECT): that would let the PR's own branch set freeze_days through the
project.yml fallback T10 rules out (team-console#742), so --offline there is a refusal too (exit 1).
"""
from __future__ import annotations

import argparse
import json
import os
import sys

sys.dont_write_bytecode = True  # the vendored copy lives in the product repo: no __pycache__ there
from datetime import date, datetime, timezone

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ptlib import calendar, console, project, teamconfig  # noqa: E402


def main() -> None:
    p = argparse.ArgumentParser(prog="slot-context", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--offline", action="store_true")
    p.add_argument("--now")
    args = p.parse_args()
    now = datetime.fromisoformat(args.now) if args.now else datetime.now(timezone.utc)
    if now.tzinfo is None:
        now = now.replace(tzinfo=calendar.KYIV)

    if args.offline and teamconfig.in_job():
        print(teamconfig.OFFLINE_IN_JOB.format(what="slot-context"), file=sys.stderr)
        sys.exit(console.EXIT_ERROR)

    sprint_title, demo, view, drift = None, None, None, []
    if not args.offline:
        try:
            view = teamconfig.load()
        except (console.ConsoleError, teamconfig.TeamConfigInvalid) as exc:
            if isinstance(exc, console.ConsoleError) and exc.type == console.NOT_CUT_OVER:
                sys.exit(console.report(exc))
            print(teamconfig.refusal(exc, "slot-context"), file=sys.stderr)
            sys.exit(console.EXIT_ERROR)
        drift = teamconfig.drift(view, project.imported_settings_from_text(project.read_text()))
        if drift:
            print(teamconfig.drift_warning(view, drift), file=sys.stderr)
        try:
            milestones = [console.as_milestone(s) for s in console.sprints("open")]
        except console.ConsoleError as exc:
            code = console.report(exc)
            if code == console.EXIT_ERROR:
                print("cannot read the sprints; rerun with --offline to skip freeze detection", file=sys.stderr)
            sys.exit(code)
        sprint = calendar.pick_current_sprint(milestones, now.astimezone(calendar.KYIV).date())
        if sprint:
            sprint_title, demo = sprint["title"], date.fromisoformat(sprint["due_on"][:10])

    if view is None:
        result = calendar.compute(now, sprint_title, demo, project.freeze_days()).to_dict()
    else:
        result = calendar.compute(now, sprint_title, demo, view["sprint"]["freeze_days"],
                                  caps_override=view["caps"]).to_dict()
        result["team_config"] = teamconfig.summary(view, drift)
    print(json.dumps(result, indent=2))


if __name__ == "__main__":
    main()
