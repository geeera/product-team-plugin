#!/usr/bin/env python3
"""Sprint numbers for the demo page and the analyst.

  sprint-metrics [--milestone "Sprint 01"|current]   plan vs shipped, median cycle time, QA first-pass rate

Items, sprints and status history come from the team console (TC_* job environment). The QA block still reads PR
reviews on GitHub (`qa.source: github-prs`): pull requests stay the VCS's until the console records verdicts.
Pair with `runlog stats` for run durations and failures.
"""
from __future__ import annotations

import argparse
import json
import os
import sys

sys.dont_write_bytecode = True  # the vendored copy lives in the product repo: no __pycache__ there
from datetime import date, datetime, timedelta

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ptlib import console, gh, metrics  # noqa: E402
from ptlib.calendar import KYIV, pick_current_sprint  # noqa: E402


def find_sprint(title: str) -> dict:
    sprints = [console.as_milestone(s) for s in console.sprints("all")]
    if title == "current":
        found = pick_current_sprint(sprints, datetime.now(KYIV).date())
    else:
        found = next((s for s in sprints if s["title"] == title), None)
    if not found:
        sys.exit(f"sprint not found: {title}")
    return found


def qa_reviews(start: str) -> dict:
    repo = gh.repo()
    prs = [pr for pr in gh.api_list(f"repos/{repo}/pulls?state=all&sort=updated&direction=desc&per_page=100")
           if pr["updated_at"][:10] >= start]
    return {pr["number"]: [r.get("body") or "" for r in
                           gh.api_list(f"repos/{repo}/pulls/{pr['number']}/reviews?per_page=100")]
            for pr in prs}


def main() -> None:
    p = argparse.ArgumentParser(prog="sprint-metrics", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--milestone", default="current")
    p.add_argument("--length-days", type=int, default=14)
    args = p.parse_args()
    try:
        sprint = find_sprint(args.milestone)
        if not sprint["due_on"]:
            sys.exit(f"sprint {sprint['title']!r} has no demo day; set it first")
        issues = console.issues({sprint["number"]: sprint["title"]}, sprint=sprint["number"], state="all")
        events = {i["number"]: console.events(i["number"]) for i in issues if i["state"] == "closed"}
    except console.ConsoleError as exc:
        sys.exit(console.report(exc))
    start = (date.fromisoformat(sprint["due_on"][:10]) - timedelta(days=args.length_days)).isoformat()
    try:
        reviews = qa_reviews(start)
    except gh.GhError as exc:
        sys.exit(str(exc))
    summary = metrics.sprint_summary(issues, events, reviews)
    summary["qa"]["source"] = "github-prs"
    summary.update(sprint=sprint["title"], demo=sprint["due_on"][:10])
    print(json.dumps(summary, indent=2))


if __name__ == "__main__":
    main()
