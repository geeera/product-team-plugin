#!/usr/bin/env python3
"""GitHub Actions workflows of the repository (used by pause/resume to stop and restart scheduled workflows).

  workflows list                 name, file, state
  workflows disable FILE...      e.g. renovate.yml
  workflows enable FILE...
  workflows run FILE             start a workflow_dispatch run on the default branch (e.g. owner-digest.yml)
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from urllib.parse import quote

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ptlib import gh  # noqa: E402


def main() -> None:
    p = argparse.ArgumentParser(prog="workflows", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list")
    sub.add_parser("run").add_argument("file")
    for name in ("disable", "enable"):
        sub.add_parser(name).add_argument("files", nargs="+")
    args = p.parse_args()
    try:
        repo = gh.repo()
        if args.cmd == "list":
            flows = gh.api(f"repos/{repo}/actions/workflows?per_page=100").get("workflows", [])
            print(json.dumps([{"name": w["name"], "file": w["path"].rsplit("/", 1)[-1], "state": w["state"]}
                              for w in flows], indent=2))
            return
        if args.cmd == "run":
            branch = gh.api(f"repos/{repo}")["default_branch"]
            gh.api(f"repos/{repo}/actions/workflows/{quote(args.file, safe='')}/dispatches", "POST", {"ref": branch})
            print(json.dumps({"started": args.file, "ref": branch}))
            return
        for f in args.files:
            gh.api(f"repos/{repo}/actions/workflows/{quote(f, safe='')}/{args.cmd}", "PUT")
        print(json.dumps({args.cmd + "d": args.files}))
    except gh.GhError as exc:
        sys.exit(str(exc))


if __name__ == "__main__":
    main()
